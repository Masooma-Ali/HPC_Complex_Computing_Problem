# GPU-accelerated KLT Makefile
CC = gcc
NVCC = nvcc
ARCH = sm_75

.PHONY: all clean run profile

all: example3_gpu

example3_gpu: libklt_gpu.a
	$(NVCC) -arch=$(ARCH) -O3 -o example3_gpu example3.c -L. -lklt_gpu -lm

libklt_gpu.a: cpu_objs gpu_objs
	ar ruv libklt_gpu.a *.o

cpu_objs:
	$(CC) -c -DNDEBUG -O3 error.c pnmio.c pyramid.c storeFeatures.c klt.c klt_util.c writeFeatures.c

gpu_objs:
	$(NVCC) -c -arch=$(ARCH) -O3 convole.cu trackfeatures.cu selectGoodFeatures.cu gpu_memory_pool.cu

run: example3_gpu
	./example3_gpu

profile: example3_gpu
	@if command -v nvprof >/dev/null 2>&1; then \
		echo "=== GPU Profiling with nvprof ==="; \
		nvprof --log-file nvprof_output.txt --print-gpu-trace ./example3_gpu; \
		echo "Profiling complete. See nvprof_output.txt for details."; \
	elif command -v nsys >/dev/null 2>&1; then \
		echo "=== GPU Profiling with nsys ==="; \
		nsys profile -o klt_gpu_profile --stats=true ./example3_gpu; \
		nsys stats --force-export=true klt_gpu_profile.nsys-rep > klt_gpu_stats.txt; \
	else \
		echo "=== Performance Measurement (time only) ==="; \
		time ./example3_gpu; \
		echo ""; \
		echo "For GPU profiling, install nvprof or nsys:"; \
		echo "  nvprof: Usually comes with CUDA toolkit"; \
		echo "  nsys: apt-get install nsight-systems-cli"; \
	fi

clean:
	rm -f *.o libklt_gpu.a example3_gpu klt_gpu_profile* klt_gpu_stats.txt nvprof_output.txt *.sqlite feat*.ppm features.*
